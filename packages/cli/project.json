{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/cli/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/cli",
        "main": "packages/cli/src/index.ts",
        "tsConfig": "packages/cli/tsconfig.lib.json",
        "assets": [
          "packages/cli/*.md",
          {
            "input": "packages/cli",
            "glob": "package.json",
            "output": "."
          }
        ]
      }
    },
    "unit": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/scripts/cli-unit.mjs"],
      "options": {
        "command": "node scripts/cli-unit.mjs"
      }
    }
  }
}
