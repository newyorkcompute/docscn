{
  "name": "mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/mcp/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/mcp",
        "main": "packages/mcp/src/index.ts",
        "tsConfig": "packages/mcp/tsconfig.lib.json",
        "assets": ["packages/mcp/*.md"]
      }
    },
    "unit": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/scripts/mcp-unit.mjs"],
      "options": {
        "command": "node scripts/mcp-unit.mjs"
      }
    }
  }
}
