{
  "name": "db",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/db/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/db",
        "main": "packages/db/src/index.ts",
        "tsConfig": "packages/db/tsconfig.lib.json",
        "assets": ["packages/db/*.md"]
      }
    },
    "unit": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/scripts/db-unit.mjs"],
      "options": {
        "command": "node scripts/db-unit.mjs"
      }
    }
  }
}
