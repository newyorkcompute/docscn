{
  "name": "docscn",
  "version": "0.0.0",
  "description": "Open-source workspace for publishing, reviewing, and revising agent-generated HTML artifacts.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "nx dev web",
    "dev:persistent": "dotenv -e .env.local -- nx dev web",
    "cli": "nx build cli && node dist/packages/cli/src/index.js",
    "mcp": "nx build mcp && node dist/packages/mcp/src/index.js",
    "build": "nx run-many -t build -p web,db,storage,sdk,cli,mcp,config",
    "start": "node apps/web/.next/standalone/apps/web/server.js",
    "build:cli:release": "node scripts/build-cli-release.mjs",
    "lint": "nx run-many -t lint -p web,ui,db,storage,sdk,cli,mcp,config",
    "test": "npm run test:cli && npm run test:mcp && npm run test:backend",
    "test:backend": "node scripts/backend-unit.mjs",
    "test:cli": "nx build cli && node scripts/cli-unit.mjs",
    "test:mcp": "nx build mcp && node scripts/mcp-unit.mjs",
    "test:mcp:integration": "nx build mcp && node scripts/mcp-integration.mjs",
    "openapi:sync": "node scripts/sync-openapi.mjs",
    "openapi:check": "node scripts/check-openapi-sync.mjs",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "smoke:agent": "nx build cli && node scripts/agent-smoke.mjs",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "setup:local": "node scripts/setup-local.mjs",
    "doctor": "node scripts/doctor.mjs",
    "db:up": "docker compose up -d postgres minio minio-init",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,css,scss,md,html,yml,yaml}": "prettier --write",
    "*.{js,mjs,cjs,ts,tsx}": "eslint --fix --no-warn-ignored"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newyorkcompute/docscn.git"
  },
  "keywords": [
    "agents",
    "html",
    "artifacts",
    "review",
    "open-source",
    "mcp"
  ],
  "author": "newyorkcompute",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/newyorkcompute/docscn/issues"
  },
  "homepage": "https://github.com/newyorkcompute/docscn#readme",
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.2.6",
    "@nx/eslint": "22.7.3",
    "@nx/eslint-plugin": "22.7.3",
    "@nx/js": "22.7.3",
    "@nx/next": "^22.7.3",
    "@nx/react": "22.7.3",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.15.40",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@yao-pkg/pkg": "^6.19.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.0.0",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^16.4.0",
    "nx": "22.7.3",
    "prettier": "~3.8.3",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.4"
  },
  "nx": {},
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-slot": "^1.2.4",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.14.0",
    "next": "~16.2.6",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  }
}
