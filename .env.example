# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth: Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Future database: Postgres + Drizzle. Vercel Neon may provide POSTGRES_URL.
DATABASE_URL=postgres://docscn:docscn@localhost:5433/docscn
# DATABASE_URL_UNPOOLED=postgres://docscn:docscn@localhost:5433/docscn
# POSTGRES_URL=postgres://docscn:docscn@localhost:5433/docscn
# POSTGRES_URL_NON_POOLING=postgres://docscn:docscn@localhost:5433/docscn
# POSTGRES_DATABASE_URL=postgres://docscn:docscn@localhost:5433/docscn
# POSTGRES_DATABASE_URL_UNPOOLED=postgres://docscn:docscn@localhost:5433/docscn

# Artifact object storage: any S3-compatible provider
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=docscn-artifacts
S3_ACCESS_KEY_ID=docscn
S3_SECRET_ACCESS_KEY=docscn-local-secret

# Future queues/cache: Redis-compatible
REDIS_URL=redis://localhost:6379
