{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@docscn/ui": ["./packages/ui/src/index.ts"],
      "@docscn/db": ["./packages/db/src/index.ts"],
      "@docscn/sdk": ["./packages/sdk/src/index.ts"],
      "@docscn/config": ["./packages/config/src/index.ts"],
      "@docscn/cli": ["./packages/cli/src/index.ts"],
      "@docscn/mcp": ["./packages/mcp/src/index.ts"],
      "@docscn/storage": ["./packages/storage/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
